// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — RiceMate Backend
// Database: PostgreSQL (Neon)
// Naming: camelCase in Prisma/TypeScript, snake_case mapped to PostgreSQL
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. User
// Stores application users.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations — records this user created/updated
  createdIncomeSources    IncomeSource[]    @relation("IncomeSourceCreatedBy")
  updatedIncomeSources    IncomeSource[]    @relation("IncomeSourceUpdatedBy")
  createdExpenses         Expense[]         @relation("ExpenseCreatedBy")
  updatedExpenses         Expense[]         @relation("ExpenseUpdatedBy")
  createdIncomeInstances  IncomeInstance[]  @relation("IncomeInstanceCreatedBy")
  updatedIncomeInstances  IncomeInstance[]  @relation("IncomeInstanceUpdatedBy")
  createdExpenseInstances ExpenseInstance[] @relation("ExpenseInstanceCreatedBy")
  updatedExpenseInstances ExpenseInstance[] @relation("ExpenseInstanceUpdatedBy")
  createdExpenseTemplates ExpenseTemplate[] @relation("ExpenseTemplateCreatedBy")
  updatedExpenseTemplates ExpenseTemplate[] @relation("ExpenseTemplateUpdatedBy")
  auditLogs               AuditLog[]

  @@map("user")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. IncomeSource
// Stores the different sources from which the business earns income.
// e.g., "Source A", "Source B", "Source C"
// ─────────────────────────────────────────────────────────────────────────────
model IncomeSource {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Audit FK
  createdById Int  @map("created_by")
  updatedById Int? @map("updated_by")

  // Relations
  createdBy       User             @relation("IncomeSourceCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?            @relation("IncomeSourceUpdatedBy", fields: [updatedById], references: [id])
  incomeInstances IncomeInstance[]

  @@map("income_source")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Expense
// Stores the expense category hierarchy (self-referencing).
//
// Example:
//   Cost              (parent_id = NULL)
//   ├── Ingredients   (parent_id = Cost.id)
//   ├── Resources     (parent_id = Cost.id)
//   └── Transport     (parent_id = Cost.id)
//   Food Need Coverage (parent_id = NULL)
// ─────────────────────────────────────────────────────────────────────────────
model Expense {
  id          Int      @id @default(autoincrement())
  parentId    Int?     @map("parent_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Audit FK
  createdById Int  @map("created_by")
  updatedById Int? @map("updated_by")

  // Self-referencing relation for hierarchy
  parent   Expense?  @relation("ExpenseHierarchy", fields: [parentId], references: [id])
  children Expense[] @relation("ExpenseHierarchy")

  // Relations
  createdBy        User              @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  expenseInstances ExpenseInstance[]
  expenseTemplates ExpenseTemplate[]

  @@map("expense")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. IncomeInstance
// Stores actual income transactions.
// e.g., 2026-08-17 | Source A | Rs. 25,000
// ─────────────────────────────────────────────────────────────────────────────
model IncomeInstance {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  sourceId    Int      @map("source_id")
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Audit FK
  createdById Int  @map("created_by")
  updatedById Int? @map("updated_by")

  // Relations
  source    IncomeSource @relation(fields: [sourceId], references: [id])
  createdBy User         @relation("IncomeInstanceCreatedBy", fields: [createdById], references: [id])
  updatedBy User?        @relation("IncomeInstanceUpdatedBy", fields: [updatedById], references: [id])

  @@map("income_instance")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. UnitCategory  (defined before Unit because Unit depends on it)
// Groups related measurement units.
// e.g., Weight, Volume, Count
// ─────────────────────────────────────────────────────────────────────────────
model UnitCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  units Unit[]

  @@map("unit_category")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. Unit  (defined before ExpenseTemplate because ExpenseTemplate depends on it)
// Stores individual measurement units.
// e.g., kg, g, L, ml, pcs, dozen
// ─────────────────────────────────────────────────────────────────────────────
model Unit {
  id             Int      @id @default(autoincrement())
  unitCategoryId Int      @map("unit_category_id")
  name           String
  symbol         String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  unitCategory     UnitCategory      @relation(fields: [unitCategoryId], references: [id])
  expenseTemplates ExpenseTemplate[]

  @@map("unit")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. ExpenseTemplate  (defined before ExpenseInstance because ExpenseInstance optionally depends on it)
// Stores frequently used expenses and their default unit price.
//
// Example:
//   Rice        | kg  | Rs. 250
//   Sugar       | kg  | Rs. 220
//   Coconut Oil | L   | Rs. 1,800
//   Milk        | L   | Rs. 450
// ─────────────────────────────────────────────────────────────────────────────
model ExpenseTemplate {
  id               Int      @id @default(autoincrement())
  expenseId        Int      @map("expense_id")
  name             String
  defaultUnitPrice Decimal  @map("default_unit_price") @db.Decimal(12, 2)
  unitId           Int      @map("unit_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Audit FK
  createdById Int  @map("created_by")
  updatedById Int? @map("updated_by")

  // Relations
  expense          Expense           @relation(fields: [expenseId], references: [id])
  unit             Unit              @relation(fields: [unitId], references: [id])
  createdBy        User              @relation("ExpenseTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("ExpenseTemplateUpdatedBy", fields: [updatedById], references: [id])
  expenseInstances ExpenseInstance[]

  @@map("expense_template")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. ExpenseInstance
// Stores actual expenses incurred.
//
// Example:
//   Item:       Rice
//   Quantity:   10 kg
//   Unit price: Rs. 250/kg
//   Amount:     Rs. 2,500    (stored explicitly for flexibility)
// ─────────────────────────────────────────────────────────────────────────────
model ExpenseInstance {
  id                Int      @id @default(autoincrement())
  date              DateTime @db.Date
  expenseId         Int      @map("expense_id")
  expenseTemplateId Int?     @map("expense_template_id")
  quantity          Decimal  @db.Decimal(12, 4)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount            Decimal  @db.Decimal(12, 2)
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Audit FK
  createdById Int  @map("created_by")
  updatedById Int? @map("updated_by")

  // Relations
  expense         Expense          @relation(fields: [expenseId], references: [id])
  expenseTemplate ExpenseTemplate? @relation(fields: [expenseTemplateId], references: [id])
  createdBy       User             @relation("ExpenseInstanceCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?            @relation("ExpenseInstanceUpdatedBy", fields: [updatedById], references: [id])

  @@map("expense_instance")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. AuditLog
// Stores per-column change history for important records.
// Written at application level (not DB triggers).
// ─────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  tableName  String      @map("table_name")
  recordId   Int         @map("record_id")
  action     AuditAction
  columnName String?     @map("column_name")
  oldValue   String?     @map("old_value")
  newValue   String?     @map("new_value")
  createdAt  DateTime    @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// The type of database operation recorded in audit_log.
enum AuditAction {
  INSERT
  UPDATE
  DELETE
}
